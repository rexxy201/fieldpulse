Options -Indexes
Options +FollowSymLinks

RewriteEngine On

# Only index.php may be requested as a URL. Every other PHP file (pages/,
# api/, includes/, vendor/, anything uploaded) is code the router loads with
# require; requested directly it would run outside the router and its checks.
# 404 rather than 403 so the response doesn't confirm the file exists. Also
# covers /file.php/extra path-info tricks and other PHP-executed extensions.
RewriteRule ^index\.php$ - [L]
RewriteRule \.(php[0-9]?|phtml|phar)(/|$) - [NC,R=404,L]

# Third-party code and templates are never served, PHP or not.
RewriteRule ^(vendor|includes)(/|$) - [NC,R=404,L]

# Serve real files and directories directly (CSS, JS, images, etc.)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Route everything else through index.php
RewriteRule ^ index.php [QSA,L]

# Security: block direct access to sensitive files
<FilesMatch "\.(sql|log|env|json|md|gitignore)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Block direct execution of config/secrets — these must only ever be loaded via
# require/include from index.php, never requested as a URL.
<FilesMatch "^(config|secrets|secrets\.example)\.php$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

